---
import BaseLayout from '../../layouts/BaseLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import PortfolioCard from '../../components/PortfolioCard.astro'
import { getPortfolios } from '../../lib/api'
import { graph, organizationSchema, webPageSchema, breadcrumbSchema, itemListSchema } from '../../lib/schema'

const portfolios = await getPortfolios()
const description = 'ตัวอย่างโปรเจกต์ที่ GeniusCorp ส่งมอบให้ลูกค้าองค์กร พร้อมผลลัพธ์ที่วัดได้จริง ทั้งเว็บไซต์องค์กร โมบายแอป และร้านค้าออนไลน์'
const crumbs = [{ name: 'หน้าแรก', url: '/' }, { name: 'ผลงาน' }]

const jsonLd = graph(
  organizationSchema(),
  webPageSchema({ url: '/portfolio/', name: 'ผลงานและลูกค้าของเรา', description, type: 'CollectionPage' }),
  breadcrumbSchema(crumbs),
  itemListSchema(portfolios.map((p) => ({ name: p.title, url: p.url }))),
)
---

<BaseLayout seo={{ title: 'ผลงานและลูกค้าของเรา', description, canonical: '/portfolio/' }}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="container">
    <Breadcrumb crumbs={crumbs} />
    <h1>ผลงานและลูกค้าของเรา</h1>
    <div class="grid">
      {portfolios.map((item) => <PortfolioCard item={item} />)}
    </div>
  </section>
</BaseLayout>
